/* NOC_Beam -- light theme (Bria-evolution direction).
   White background, warm orange brand accent, green call button.
   Targets the Bria-style narrow vertical softphone shell. */


/* ------------------------------------------------------------------
   Base
   ------------------------------------------------------------------ */
QWidget {
    background-color: #FFFFFF;
    color:            #20232E;
    font-family:      "Segoe UI", "Inter", sans-serif;
    font-size:        13px;
    selection-background-color: #EEF0FC;
    selection-color:  #20232E;
}

QMainWindow, QDialog {
    background-color: #FFFFFF;
}


/* ------------------------------------------------------------------
   Menu bar (native Bria-style: top of window, no chrome)
   ------------------------------------------------------------------ */
QMenuBar {
    background-color: #FFFFFF;
    color: #6A6A75;
    border: none;
    border-bottom: 1px solid #E5E7EE;
    padding: 2px 4px;
}
QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    border-radius: 3px;
}
QMenuBar::item:selected { background-color: #E5E7EE; color: #20232E; }

QMenu {
    background-color: #FFFFFF;
    color: #20232E;
    border: 1px solid #D5D9E4;
    padding: 4px 0;
}
QMenu::item { padding: 6px 18px; }
QMenu::item:selected { background-color: #EEF0FC; color: #20232E; }
QMenu::separator { height: 1px; background: #E5E7EE; margin: 4px 6px; }


/* ------------------------------------------------------------------
   Top strip: brand + account + audio + status
   ------------------------------------------------------------------ */
QLabel#BrandMark {
    /* Now displays the real app icon as a QPixmap; chrome stripped. */
    background: transparent;
    min-width: 28px;
    min-height: 28px;
    max-width: 28px;
    max-height: 28px;
    padding: 0;
}
QLabel#BrandWord {
    color: #20232E;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.005em;
}
QLabel#BrandVer {
    color: #9AA0B0;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 10px;
    letter-spacing: 0.04em;
}
QToolButton#MenuButton {
    background: transparent;
    color: #6A6A75;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 0 8px;
    min-width: 28px;
    min-height: 28px;
    font-size: 18px;
    font-weight: 700;
}
QToolButton#MenuButton:hover {
    background-color: #E5E7EE;
    color: #20232E;
    border-color: #D5D9E4;
}
QToolButton#MenuButton::menu-indicator { image: none; width: 0; }

QLabel#AccountKicker {
    color: #6A6A75;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 11px;
    font-weight: 500;
}
QToolButton#AccountChip {
    background-color: #FFFFFF;
    color: #20232E;
    border: 1px solid #E5E7EE;
    border-radius: 14px;
    padding: 4px 12px 4px 8px;
    font-size: 12px;
    font-weight: 600;
    min-height: 24px;
}
QToolButton#AccountChip[health="ok"]     { color: #2BA36B; border-color: rgba(43, 163, 107, 0.4); }
QToolButton#AccountChip[health="danger"] { color: #A33A3E; border-color: rgba(216, 75, 80, 0.4); }
QToolButton#AccountChip[health="muted"]  { color: #6A6A75; }
QToolButton#AccountChip:hover {
    background-color: #E5E7EE;
    border-color: #E5E7EE;
}
QToolButton#AccountChip::menu-indicator { image: none; width: 0; }

/* ------------------------------------------------------------------
   Audio strip (mic + speaker + slider with orange fill)
   ------------------------------------------------------------------ */
QFrame#AudioStrip {
    background-color: #FFFFFF;
    border: none;
}
QToolButton#AudioBtn {
    background: transparent;
    color: #6A6A75;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px;
    min-width: 24px;
    min-height: 24px;
}
QToolButton#AudioBtn:hover { background-color: #E5E7EE; color: #20232E; }
QToolButton#AudioBtn::menu-indicator { image: none; width: 0; }

QSlider#VolumeSlider::groove:horizontal {
    height: 6px;
    background: #E5E7EE;
    border-radius: 3px;
}
QSlider#VolumeSlider::sub-page:horizontal {
    background: #5B6EE0;
    border-radius: 3px;
}
QSlider#VolumeSlider::add-page:horizontal {
    background: #E5E7EE;
    border-radius: 3px;
}
QSlider#VolumeSlider::handle:horizontal {
    background: #FFFFFF;
    border: 1.5px solid #5B6EE0;
    width: 12px;
    margin: -4px 0;
    border-radius: 7px;
}
QSlider#VolumeSlider::handle:horizontal:hover { border-color: #6C7EE8; }


/* ------------------------------------------------------------------
   Status banner (account state, registration messages)
   ------------------------------------------------------------------ */
QLabel#StatusBanner {
    color: #6A6A75;
    font-size: 12px;
    font-weight: 500;
    qproperty-alignment: AlignCenter;
    padding: 6px 14px;
}
QLabel#StatusBanner[level="ok"]      { color: #2BA36B; }
QLabel#StatusBanner[level="warn"]    { color: #B07811; }
QLabel#StatusBanner[level="danger"]  { color: #D84B50; }
QLabel#StatusBannerLink {
    color: #3D77C2;
    font-size: 12px;
    qproperty-alignment: AlignCenter;
    padding: 0 14px 6px;
}
QLabel#StatusBannerLink:hover { color: #2B5789; text-decoration: underline; }


/* ------------------------------------------------------------------
   Dial bar (input + green call button)
   ------------------------------------------------------------------ */
QFrame#DialBar {
    background-color: #FFFFFF;
    border: none;
}
QLineEdit#DialInput:focus {
    background-color: #FFFFFF;
    border-color: #5B6EE0;
}
QPushButton#CallButton:hover { background-color: #6C7EE8; border-color: #6C7EE8; }
QPushButton#CallButton:pressed { background-color: #4A5BC9; border-color: #4A5BC9; }
QPushButton#CallButton:disabled { background-color: #E5E7EE; color: #9AA0B0; border-color: #E5E7EE; }
QPushButton#HangupButton:hover { background-color: #D84B50; border-color: #D84B50; }
QPushButton#HangupButton:disabled { background-color: #E9EBF2; color: #D5D9E4; border-color: #E5E7EE; }

/* Neutral in-call control (Hold / Mute / Transfer). Reads as
   secondary against the green/red lifecycle buttons. */
QPushButton#InCallBtn {
    background-color: #FFFFFF;
    color: #20232E;
    border: 1px solid #D5D9E4;
    border-radius: 4px;
    padding: 7px 14px;
    min-height: 24px;
    min-width: 44px;
    font-weight: 500;
}
QPushButton#InCallBtn:hover  { background-color: #E9EBF2; border-color: #9AA0B0; }
QPushButton#InCallBtn:pressed { background-color: #E5E7EE; }
QPushButton#InCallBtn:checked { background-color: #EEF0FC; border-color: #5B6EE0; color: #4A5BC9; }
QPushButton#InCallBtn:disabled { background-color: #E9EBF2; color: #D5D9E4; border-color: #E5E7EE; }

/* ---- CallWidget card (mockup panel 2) -------------------------- */
QWidget#CallWidget { background-color: transparent; }

/* The card itself: rounded surface with a subtle border. The card's
   `state` property tints the left border so the user can see at a
   glance whether the call is incoming, ringing out, or established. */
/* Bria-style: flat tile, no colored stripe. State lives in the avatar
   tint and the duration text only. The colored left border read as
   "homemade" in user testing. */
QFrame#CallCard {
    background-color: #FFFFFF;
    border: none;
    border-bottom: 1px solid #E5E7EE;
    border-radius: 0;
}
QFrame#CallCard[state="incoming"] { background-color: #F9E5E6; }

/* Avatar -- small round tint that carries the call's state. */
QLabel#CallAvatar {
    background-color: #2BA36B;
    color: #FFFFFF;
    border-radius: 14px;
    font-size: 14px;
    font-weight: 700;
    qproperty-alignment: AlignCenter;
}
QFrame#CallCard[state="incoming"] QLabel#CallAvatar { background-color: #D84B50; }
QFrame#CallCard[state="outgoing"] QLabel#CallAvatar { background-color: #5B6EE0; }
QFrame#CallCard[state="idle"]     QLabel#CallAvatar { background-color: #D5D9E4; }
/* Explicit override for active so Qt's QSS engine doesn't carry the
   prior idle/outgoing background through state transitions. */
QFrame#CallCard[state="active"]   QLabel#CallAvatar { background-color: #2BA36B; }

/* Peer block: headline number / SIP user up top, secondary name below.
   Use the system UI font, not mono -- mono on a contact name reads
   like a terminal app. */
QLabel#CallPeer {
    color: #20232E;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
}
QLabel#CallPeerSub {
    color: #9AA0B0;
    font-size: 11px;
    font-weight: 400;
}

/* Right-side status pill on the card. Colour-coded by SIP family. */
QLabel#CallStatePill {
    background-color: #E5E7EE;
    color: #6A6A75;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 1px 10px;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.04em;
}
QLabel#CallStatePill[level="ok"]       { background-color: #E2F4EA; color: #2BA36B; border-color: rgba(43, 163, 107,0.4); }
QLabel#CallStatePill[level="progress"] { background-color: #FBF1DD; color: #B07811; border-color: rgba(176, 120, 17,0.45); }
QLabel#CallStatePill[level="auth"]     { background-color: #FBF1DD; color: #B07811; border-color: rgba(176, 120, 17,0.55); }
QLabel#CallStatePill[level="error"]    { background-color: #F9E5E6; color: #A33A3E; border-color: rgba(216, 75, 80,0.45); }

/* Duration counter -- prominent monospaced timer below the status pill. */
QLabel#CallDuration {
    color: #20232E;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
}

/* End Call button: ~2x wider than the secondary controls (driven by
   the layout's stretch factor). Big, red, unmissable. */
QPushButton#EndCallButton {
    background-color: #D84B50;
    color: #FFFFFF;
    border: 1px solid #D84B50;
    border-radius: 6px;
    padding: 0 18px;
    min-height: 40px;
    font-weight: 700;
    font-size: 13px;
}
QPushButton#EndCallButton:hover    { background-color: #D84B50; border-color: #D84B50; }
QPushButton#EndCallButton:pressed  { background-color: #A33A3E; border-color: #A33A3E; }
QPushButton#EndCallButton:disabled { background-color: #E9EBF2; color: #D5D9E4; border-color: #E5E7EE; }

/* Codec + quality muted secondary line under the card. */
QLabel#CallCodec, QLabel#CallQuality {
    color: #9AA0B0;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 10px;
    font-weight: 400;
}


/* ------------------------------------------------------------------
   Dialpad (Bria-style: typography over chrome)
   ------------------------------------------------------------------ */
QFrame#Dialpad { background-color: #FFFFFF; border: none; }
QPushButton#DialpadKey {
    background: transparent;
    color: #20232E;
    border: none;
    border-radius: 4px;
    padding: 0;
    min-height: 30px;
    max-height: 36px;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.02em;
}
QPushButton#DialpadKey:hover { background-color: #E9EBF2; }
QPushButton#DialpadKey:pressed { background-color: #E5E7EE; }
QPushButton#DialpadKey:disabled { color: #D5D9E4; }


/* ------------------------------------------------------------------
   Bottom tab bar (4 icons, orange when active)
   ------------------------------------------------------------------ */
QToolButton#TabBtn:hover { color: #6A6A75; background-color: #E9EBF2; }
QToolButton#TabBtn[badged="true"] {
    color: #D84B50;
    font-weight: 700;
}
QToolButton#TabBtn:focus {
    border: 1px solid #5B6EE0;
    border-top: 2px solid #5B6EE0;
    background-color: #EEF0FC;
}

/* Per-row redial button on History rows */
QToolButton#HistoryRowCall {
    background-color: #5B6EE0;
    color: #FFFFFF;
    border: 1px solid #5B6EE0;
    border-radius: 14px;
    padding: 4px 10px;
    font-size: 13px;
    font-weight: 600;
    min-width: 28px;
    min-height: 28px;
}
QToolButton#HistoryRowCall:hover { background-color: #6C7EE8; border-color: #6C7EE8; }
QToolButton#HistoryRowCall:disabled {
    background-color: #E5E7EE;
    color: #D5D9E4;
    border-color: #E5E7EE;
}


/* ------------------------------------------------------------------
   Lists (calls / accounts / history)
   ------------------------------------------------------------------ */
QListWidget, QTableWidget, QTableView {
    background-color: #FFFFFF;
    color: #20232E;
    alternate-background-color: #E9EBF2;
    border: 1px solid #E5E7EE;
    border-radius: 4px;
    gridline-color: #E5E7EE;
    outline: 0;
}
QListWidget::item, QTableView::item {
    padding: 6px 10px;
    border: none;
}
QListWidget::item:hover, QTableView::item:hover { background-color: #E9EBF2; }
QListWidget::item:selected, QTableView::item:selected {
    background-color: #EEF0FC;
    color: #20232E;
    border-left: 2px solid #5B6EE0;
}

QHeaderView::section {
    background-color: #E9EBF2;
    color: #6A6A75;
    border: none;
    border-right: 1px solid #E5E7EE;
    border-bottom: 1px solid #E5E7EE;
    padding: 6px 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 10px;
}


/* ------------------------------------------------------------------
   Inputs (general)
   ------------------------------------------------------------------ */
QLineEdit, QComboBox, QSpinBox, QTextEdit, QPlainTextEdit {
    background-color: #FFFFFF;
    color: #20232E;
    border: 1px solid #D5D9E4;
    border-radius: 4px;
    padding: 5px 10px;
    min-height: 22px;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #5B6EE0;
}

QPushButton {
    background-color: #FFFFFF;
    color: #20232E;
    border: 1px solid #D5D9E4;
    border-radius: 4px;
    padding: 6px 14px;
    min-height: 26px;
}
QPushButton:hover { background-color: #E9EBF2; border-color: #9AA0B0; }
QPushButton:pressed { background-color: #E5E7EE; }
QPushButton:disabled { color: #9AA0B0; background-color: #E9EBF2; border-color: #E5E7EE; }
QPushButton:focus { outline: none; border-color: #5B6EE0; }

QPushButton#PrimaryAction:hover { background-color: #6C7EE8; border-color: #6C7EE8; }
QPushButton#PrimaryAction:pressed { background-color: #4A5BC9; }


/* ------------------------------------------------------------------
   Scrollbar (slim, neutral)
   ------------------------------------------------------------------ */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #D5D9E4;
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover { background: #9AA0B0; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal { background: transparent; height: 8px; margin: 0; }
QScrollBar::handle:horizontal {
    background: #D5D9E4;
    border-radius: 4px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover { background: #9AA0B0; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }


/* ------------------------------------------------------------------
   Tooltip
   ------------------------------------------------------------------ */
QToolTip {
    background: #20232E;
    color: #FFFFFF;
    border: 1px solid #20232E;
    padding: 4px 8px;
    border-radius: 3px;
}


/* ------------------------------------------------------------------
   Splitter / dialog message box
   ------------------------------------------------------------------ */
QSplitter::handle { background: #E5E7EE; }
QMessageBox { background-color: #FFFFFF; }
QMessageBox QLabel { color: #20232E; }


/* ==================================================================
   Phase J -- light-theme equivalents of selectors that were only in
   dark.qss. Without these blocks the trace toolbar checkboxes render
   as default Win 11 blue checkboxes, the diagnostics results area
   becomes a black rectangle in the light dialog, the accounts master
   pane overflows the narrow shell, etc.
   ================================================================== */


/* ---- Tabs (light) -- used by Settings + Diagnostics tabs ---------- */
QTabWidget::pane {
    border: 1px solid #E5E7EE;
    background: #FFFFFF;
    top: -1px;
}
QTabBar { background: #FFFFFF; }
QTabBar::tab {
    background: transparent;
    color: #6A6A75;
    padding: 8px 14px;
    border: none;
    border-bottom: 2px solid transparent;
    margin-right: 2px;
}
QTabBar::tab:hover { color: #20232E; }
QTabBar::tab:selected {
    color: #5B6EE0;
    border-bottom-color: #5B6EE0;
    background: #FFFFFF;
    font-weight: 600;
}


/* ---- Trace destination toolbar + preset chips -------------------- */
QFrame#TraceToolbar {
    background-color: #FFFFFF;
    border: none;
    border-bottom: 1px solid #E5E7EE;
}
QFrame#TraceChipBar {
    background-color: #E9EBF2;
    border: none;
    border-bottom: 1px solid #E5E7EE;
}
QToolButton#TraceChip {
    background-color: #FFFFFF;
    color: #6A6A75;
    border: 1px solid #D5D9E4;
    border-radius: 12px;
    padding: 4px 10px;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 11px;
    font-weight: 600;
    min-height: 22px;
}
QToolButton#TraceChip:hover {
    background-color: #E9EBF2;
    border-color: #9AA0B0;
    color: #20232E;
}
QToolButton#TraceChip:checked {
    background-color: #EEF0FC;
    border-color: #5B6EE0;
    color: #4A5BC9;
}

/* RX / TX chip-style toggles. QToolButton instead of QCheckBox so we
   don't fight the QCheckBox::indicator rendering. */
QToolButton#TraceDirToggle {
    color: #9AA0B0;
    background-color: #FFFFFF;
    border: 1px solid #D5D9E4;
    border-radius: 12px;
    padding: 3px 12px;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.10em;
    min-height: 20px;
    min-width: 38px;
}
QToolButton#TraceDirToggle:hover { border-color: #9AA0B0; color: #6A6A75; }
QToolButton#TraceDirToggle:focus { outline: none; }
QToolButton#TraceDirToggle[dir="rx"]:checked {
    color: #3D77C2;
    background-color: #E6F0FA;
    border-color: #3D77C2;
}
QToolButton#TraceDirToggle[dir="tx"]:checked {
    color: #4A5BC9;
    background-color: #EEF0FC;
    border-color: #5B6EE0;
}
QLineEdit#TraceFilter {
    background-color: #E5E7EE;
    color: #20232E;
    border: 1px solid #E5E7EE;
    border-radius: 4px;
    padding: 5px 10px;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 12px;
    min-height: 22px;
}
QLineEdit#TraceFilter:focus {
    background-color: #FFFFFF;
    border-color: #5B6EE0;
}


/* ---- Trace fast-filter chip row --------------------------------- */
QToolButton#TraceFastChip {
    background-color: #FFFFFF;
    color: #6A6A75;
    border: 1px solid #D5D9E4;
    border-radius: 10px;
    padding: 2px 8px;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 10px;
    font-weight: 600;
    min-height: 18px;
}
QToolButton#TraceFastChip:hover { border-color: #9AA0B0; color: #20232E; }
QToolButton#TraceFastChip:checked {
    background-color: #EEF0FC;
    border-color: #5B6EE0;
    color: #4A5BC9;
}

/* ---- Trace dialog rows (Call-ID grouped) ------------------------ */
QFrame#TraceDialogRow {
    background-color: #FFFFFF;
    border: none;
    border-bottom: 1px solid #D5D9E4;
    border-left: 3px solid transparent;
}
QFrame#TraceDialogRow:hover { background-color: #E9EBF2; }
QFrame#TraceDialogRow[state="ok"]      { border-left: 3px solid #2BA36B; }
QFrame#TraceDialogRow[state="error"]   { border-left: 3px solid #D84B50; }
QFrame#TraceDialogRow[state="pending"] { border-left: 3px solid #B07811; }

QLabel#TraceCaret {
    color: #9AA0B0;
    font-size: 11px;
}
QLabel#TraceDialogTime {
    color: #9AA0B0;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 11px;
    font-weight: 500;
}
QLabel#TraceDialogId {
    color: #6A6A75;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 11px;
    font-weight: 500;
}
QFrame#TraceChipsHolder { background: transparent; border: none; }

/* Pill chips inside the dialog summary */
QLabel#TraceChipPill {
    background-color: #E5E7EE;
    color: #6A6A75;
    border: 1px solid #D5D9E4;
    border-radius: 8px;
    padding: 0 6px;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.04em;
    min-width: 28px;
    qproperty-alignment: AlignCenter;
}
QLabel#TraceChipPill[level="method"] {
    background-color: #E6F0FA;
    color: #2B5789;
    border-color: rgba(61, 119, 194, 0.4);
}
QLabel#TraceChipPill[level="ok"] {
    background-color: #E2F4EA;
    color: #2BA36B;
    border-color: rgba(43, 163, 107, 0.4);
}
QLabel#TraceChipPill[level="progress"] {
    background-color: #EEF0FC;
    color: #4A5BC9;
    border-color: rgba(91, 110, 224, 0.3);
}
QLabel#TraceChipPill[level="warn"] {
    background-color: #FBF1DD;
    color: #B07811;
    border-color: rgba(176, 120, 17, 0.4);
}
QLabel#TraceChipPill[level="auth"] {
    background-color: #FBF1DD;
    color: #B07811;
    border-color: rgba(176, 120, 17, 0.5);
}
QLabel#TraceChipPill[level="error"] {
    background-color: #F9E5E6;
    color: #A33A3E;
    border-color: rgba(216, 75, 80, 0.4);
}
QLabel#TraceChipArrow {
    color: #D5D9E4;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 10px;
}

/* Expanded dialog body + per-message rows */
QFrame#TraceDialogBody { background-color: #E9EBF2; border: none; }
QFrame#TraceMsgRow {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid #D5D9E4;
}
QFrame#TraceMsgRow:hover { background-color: #FFFFFF; }
QFrame#TraceMsgRow[dir="rx"] { border-left: 2px solid #3D77C2; }
QFrame#TraceMsgRow[dir="tx"] { border-left: 2px solid #5B6EE0; }
QLabel#TraceMsgTime {
    color: #9AA0B0;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 11px;
}
QLabel#TraceMsgDir {
    color: #6A6A75;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 9px;
    font-weight: 700;
    padding: 0 4px;
    border: 1px solid #D5D9E4;
    border-radius: 3px;
}
QLabel#TraceMsgDir[dir="rx"] { color: #3D77C2; border-color: rgba(61, 119, 194, 0.4); }
QLabel#TraceMsgDir[dir="tx"] { color: #4A5BC9; border-color: rgba(91, 110, 224, 0.4); }
QLabel#TraceMsgSummary {
    color: #20232E;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 11px;
    font-weight: 500;
}
/* ---- Trace row list (Wireshark-style) --------------------------- */
QScrollArea#TraceScroll { background-color: #FFFFFF; border: none; }
QFrame#TraceRowList    { background-color: #FFFFFF; border: none; }

QLabel#TraceEmpty {
    color: #9AA0B0;
    font-size: 13px;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    line-height: 1.6;
    padding: 40px 24px;
}

QFrame#TraceRow {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid #E5E7EE;
    border-left: 3px solid transparent;
}
QFrame#TraceRow:hover { background-color: #E9EBF2; }
QFrame#TraceRow[dir="rx"]    { border-left: 3px solid #3D77C2; }
QFrame#TraceRow[dir="tx"]    { border-left: 3px solid #5B6EE0; }
QFrame#TraceRow[dir="error"] {
    border-left: 3px solid #D84B50;
    background-color: #F9E5E6;
}

QLabel#TraceRowTime {
    color: #9AA0B0;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 11px;
    font-weight: 600;
}
QLabel#TraceRowDir {
    color: #6A6A75;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.10em;
    padding: 0 4px;
    border: 1px solid transparent;
    border-radius: 3px;
}
QLabel#TraceRowDir[dir="rx"]    { color: #3D77C2; border-color: rgba(61, 119, 194, 0.32); }
QLabel#TraceRowDir[dir="tx"]    { color: #4A5BC9; border-color: rgba(91, 110, 224, 0.32); }
QLabel#TraceRowDir[dir="error"] { color: #D84B50; border-color: rgba(216, 75, 80, 0.32); }
QLabel#TraceRowSummary {
    color: #20232E;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 12px;
    font-weight: 600;
}
QLabel#TraceRowPeer {
    color: #9AA0B0;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 11px;
}
QTextEdit#TraceRowBody {
    background-color: #E9EBF2;
    color: #20232E;
    border: none;
    border-top: 1px solid #E5E7EE;
    border-radius: 0;
    padding: 8px 14px;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 11px;
}


/* ---- View / accounts surfaces (header titles, hints) ------------ */
QLabel#ViewTitle {
    color: #20232E;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.005em;
    padding: 0;
    margin: 0;
}
QLabel#ViewCount {
    color: #9AA0B0;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
}
QLabel#ViewHint {
    color: #9AA0B0;
    font-size: 12px;
    line-height: 1.5;
}
QLabel#ViewEmpty {
    color: #9AA0B0;
    font-size: 13px;
    qproperty-alignment: AlignCenter;
    padding: 40px 24px;
}


/* ---- Accounts master panel (light) ------------------------------ */
QFrame#AcctMaster {
    background-color: #FFFFFF;
    border: none;
    border-right: 1px solid #E5E7EE;
}
QFrame#AcctDetail {
    background-color: #FFFFFF;
    border: none;
}
QLineEdit#AcctSearch {
    background-color: #E5E7EE;
    color: #20232E;
    border: 1px solid #E5E7EE;
    border-radius: 4px;
    padding: 6px 10px;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 12px;
    min-height: 26px;
}
QLineEdit#AcctSearch:focus {
    background-color: #FFFFFF;
    border-color: #5B6EE0;
}

QFrame#AcctRow {
    background-color: transparent;
    border: none;
    border-left: 3px solid transparent;
    border-bottom: 1px solid #E5E7EE;
    padding: 10px 12px;
}
QFrame#AcctRow:hover { background-color: #E9EBF2; }
/* Softer focused state: pale-orange wash instead of the hot amber
   #EEF0FC -- the previous fill made the gray URI text unreadable
   on the focused row. */
QFrame#AcctRow[state="focused"] {
    background-color: #EEF0FC;
    border-left: 3px solid #5B6EE0;
}
QFrame#AcctRow[state="error"] { background-color: #F9E5E6; }

QLabel#AcctRowName  {
    background: transparent;
    border: none;
    color: #20232E;
    font-size: 13px;
    font-weight: 600;
}
QFrame#AcctRow[state="focused"] QLabel#AcctRowName { color: #20232E; }
QLabel#AcctRowStatus {
    background: transparent;
    border: none;
    color: #6A6A75;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.02em;
    padding-left: 4px;
}
QLabel#AcctRowUri   {
    background: transparent;
    color: #6A6A75;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 11px;
    padding-left: 18px;
    border: none;
    qproperty-frameShape: NoFrame;
}
QFrame#AcctRow[state="focused"] QLabel#AcctRowUri { color: #20232E; }
QLabel#AcctRowMeta {
    background: transparent;
    border: none;
    color: #9AA0B0;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 10px;
    letter-spacing: 0.04em;
}

/* Hover-revealed action overlay for AcctRow */
QFrame#AcctRowActions {
    background: transparent;
    border: none;
}
QToolButton#AcctRowActionBtn {
    background: transparent;
    color: #6A6A75;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 2px;
    min-width: 22px;
    min-height: 22px;
}
QToolButton#AcctRowActionBtn:hover {
    background-color: #E5E7EE;
    border-color: #D5D9E4;
    color: #20232E;
}

/* Bulk action button (Refresh all / Test all) */
QPushButton#AcctBulkBtn {
    background-color: #FFFFFF;
    color: #6A6A75;
    border: 1px solid #D5D9E4;
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    min-height: 22px;
}
QPushButton#AcctBulkBtn:hover {
    background-color: #EEF0FC;
    border-color: #5B6EE0;
    color: #4A5BC9;
}
QPushButton#AcctBulkBtn:disabled {
    background-color: #E9EBF2;
    color: #D5D9E4;
    border-color: #E5E7EE;
}

/* Account badges (TLS / SRTP / disabled) */
QLabel#AcctBadge {
    background-color: #E5E7EE;
    color: #6A6A75;
    border: 1px solid #D5D9E4;
    border-radius: 3px;
    padding: 1px 6px;
    margin-left: 18px;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.06em;
}
QLabel#AcctBadge[level="ok"] {
    color: #2BA36B;
    background-color: #E2F4EA;
    border-color: rgba(43, 163, 107, 0.4);
}
QLabel#AcctBadge[level="warn"] {
    color: #B07811;
    background-color: #FBF1DD;
    border-color: rgba(176, 120, 17, 0.4);
}
QLabel#AcctBadge[level="danger"] {
    color: #A33A3E;
    background-color: #F9E5E6;
    border-color: rgba(216, 75, 80, 0.4);
}
QLabel#AcctBadge[level="info"] {
    color: #2B5789;
    background-color: #E6F0FA;
    border-color: rgba(61, 119, 194, 0.4);
}


/* ---- Diagnostics surfaces (panel hints + results pane) ---------- */
QLabel#DiagHint {
    color: #9AA0B0;
    font-size: 12px;
    line-height: 1.5;
}
QLabel#DiagValue {
    background-color: transparent;
    color: #20232E;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 12px;
}
QTextEdit#DiagResults {
    background-color: #E9EBF2;
    color: #20232E;
    border: 1px solid #E5E7EE;
    border-radius: 4px;
    padding: 8px 10px;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 11px;
}

QFrame#StatCard {
    background-color: #E9EBF2;
    border: 1px solid #E5E7EE;
    border-radius: 4px;
    padding: 12px 14px;
}
QFrame#LastIncident {
    background-color: #F9E5E6;
    border: 1px solid rgba(216, 75, 80, 0.35);
    border-radius: 4px;
    padding: 12px 14px;
}
QLabel#IncidentTitle {
    background-color: transparent;
    color: #A33A3E;
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
}


/* ---- Contacts + Favorites tabs (Bria-parity) -------------------- */
QWidget#ContactsView, QWidget#FavoritesView {
    background-color: #FFFFFF;
}
QFrame#ContactsBody { background-color: #FFFFFF; border: none; }
QScrollArea#ContactsScroll { background-color: #FFFFFF; border: none; }

QLineEdit#ContactsSearch {
    background-color: #E5E7EE;
    color: #20232E;
    border: 1px solid #E5E7EE;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 12px;
    min-height: 24px;
}
QLineEdit#ContactsSearch:focus {
    background-color: #FFFFFF;
    border-color: #5B6EE0;
}

QToolButton#ContactsActionBtn {
    background: transparent;
    color: #6A6A75;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px;
    min-width: 28px;
    min-height: 28px;
}
QToolButton#ContactsActionBtn:hover {
    background-color: #E5E7EE;
    color: #20232E;
}

QFrame#ContactGroupRow {
    background-color: transparent;
    border: 0;
    border-bottom: 1px solid #E5E7EE;
    /* Padding moved off the layout's contentsMargins so the hover
       bg paints full width. */
    padding: 8px 12px;
    margin: 0;
}
QFrame#ContactGroupRow:hover { background-color: #E9EBF2; }
QLabel#GroupName {
    background-color: transparent;
    color: #20232E;
    font-size: 13px;
    font-weight: 500;
}
QLabel#GroupCount {
    background-color: transparent;
    color: #9AA0B0;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 11px;
}
QToolButton#GroupChevron {
    background: transparent;
    border: none;
    padding: 0;
    min-width: 16px;
    min-height: 16px;
}
QFrame#ContactRow, QFrame#FavoriteRow {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid #E5E7EE;
}
/* See ContactGroupRow:hover comment -- full-row tint dropped.
   Also covers focus/pressed/selected so a clicked row doesn't
   paint a slightly-different bg either. */
QFrame#ContactRow:hover,
QFrame#ContactRow:focus,
QFrame#ContactRow:pressed,
QFrame#FavoriteRow:hover,
QFrame#FavoriteRow:focus,
QFrame#FavoriteRow:pressed {
    background-color: transparent;
    outline: none;
}
QLabel#ContactFavorite {
    color: #5B6EE0;
    font-size: 13px;
    font-weight: 700;
}
QLabel#ContactName {
    color: #20232E;
    font-size: 13px;
    font-weight: 500;
}
QLabel#ContactNumber {
    color: #9AA0B0;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 11px;
}
QToolButton#ContactRowActionBtn {
    background: transparent;
    color: #6A6A75;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px;
    min-width: 24px;
    min-height: 24px;
}
QToolButton#ContactRowActionBtn:hover {
    background-color: #E5E7EE;
    border-color: #D5D9E4;
    color: #20232E;
}
QToolButton#ContactRowActionBtn::menu-indicator { image: none; width: 0; }
QLabel#StatLabel {
    background-color: transparent;
    color: #9AA0B0;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
}

/* ---- History row list (Bria-style, replaces the old QTableWidget) -- */
QScrollArea#HistoryScroll { background-color: #FFFFFF; border: none; }

QFrame#HistoryRow {
    background-color: transparent;
    border: 0;
    border-bottom: 1px solid #E5E7EE;
    /* Padding moved off the layout's contentsMargins so the hover
       bg paints full width. */
    padding: 6px;
    margin: 0;
}
/* Full-row gray hover. The arrow + SipCodeBadge carry the
   missed/failed signal already, so the idle state stays transparent;
   only hover paints. (Per-state idle bg:transparent for [missed]/
   [failed] is set further down -- see QFrame#HistoryRow[result=...]
   in the consolidated section.) */
QFrame#HistoryRow:hover,
QFrame#HistoryRow:focus,
QFrame#HistoryRow:pressed,
QFrame#HistoryRow[result="missed"]:hover,
QFrame#HistoryRow[result="failed"]:hover {
    background-color: #E9EBF2;
    outline: none;
}

QLabel#HistoryRowArrow {
    background-color: transparent;
    color: #2BA36B;   /* answered = green */
    font-size: 14px;
    font-weight: 700;
}
QLabel#HistoryRowArrow[result="missed"] { color: #D84B50; }
QLabel#HistoryRowArrow[result="failed"] { color: #B07811; }

QLabel#HistoryRowPeer {
    background-color: transparent;
    color: #20232E;
    font-size: 13px;
    font-weight: 500;
}
/* Bold + red the peer text on missed rows so the row is scannable
   without mouseover. */
QLabel#HistoryRowPeer[result="missed"] {
    color: #A33A3E;
    font-weight: 700;
}
QLabel#HistoryRowMeta {
    background-color: transparent;
    color: #9AA0B0;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 10px;
    letter-spacing: 0.04em;
}

/* Search box above the filter row. */
QLineEdit#HistorySearch {
    background-color: #E9EBF2;
    border: 1px solid #D5D9E4;
    border-radius: 4px;
    padding: 4px 8px;
    color: #20232E;
    selection-background-color: #E6F0FA;
}
QLineEdit#HistorySearch:focus {
    border-color: #2B5789;
    background-color: #FFFFFF;
}

/* Info (i) button per row -- monochrome, hover only. */
QToolButton#HistoryRowInfo {
    background-color: transparent;
    border: 1px solid #D5D9E4;
    border-radius: 11px;
    color: #6A6A75;
    font-weight: 700;
    font-size: 11px;
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
}
QToolButton#HistoryRowInfo:hover {
    background-color: #E6F0FA;
    border-color: #D5D9E4;
    color: #20232E;
}

/* ---- CDR detail dialog headings ---------------------------------- */
QLabel#CdrDetailPeer {
    color: #20232E;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 15px;
    font-weight: 600;
}
QLabel#CdrDetailDirection {
    color: #9AA0B0;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
}
QLabel#CdrDetailValue {
    color: #20232E;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 12px;
}

/* ---- First-run hero (cold launch when no accounts configured) ---- */
QFrame#FirstRunHero {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EE;
    border-radius: 8px;
}
QLabel#FirstRunTitle {
    color: #20232E;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.005em;
}
QLabel#FirstRunSub {
    color: #6A6A75;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.4;
}
QLabel#FirstRunHelp {
    color: #9AA0B0;
    font-size: 11px;
}

/* ---- Test Runner badges + footer counters (mockup panel 8) ------ */
QLabel#TestRunnerBadge {
    background-color: #E5E7EE;
    color: #6A6A75;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 1px 8px;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.05em;
    min-width: 52px;
    qproperty-alignment: AlignCenter;
}
QLabel#TestRunnerBadge[level="pass"]    { background-color: #E2F4EA; color: #2BA36B; border-color: rgba(43, 163, 107,0.45); }
QLabel#TestRunnerBadge[level="fail"]    { background-color: #F9E5E6; color: #A33A3E; border-color: rgba(216, 75, 80,0.50); }
QLabel#TestRunnerBadge[level="running"] { background-color: #E6F0FA; color: #2B5789; border-color: rgba(61, 119, 194,0.50); }
QLabel#TestRunnerBadge[level="queued"]  { background-color: #FFFFFF; color: #9AA0B0; border-color: #E5E7EE; }

/* Footer counters (one chip per status) */
QLabel#TestRunnerCounter {
    background-color: #E5E7EE;
    color: #6A6A75;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 600;
}
QLabel#TestRunnerCounter[level="passed"]  { background-color: #E2F4EA; color: #2BA36B; border-color: rgba(43, 163, 107,0.45); }
QLabel#TestRunnerCounter[level="failed"]  { background-color: #F9E5E6; color: #A33A3E; border-color: rgba(216, 75, 80,0.50); }
QLabel#TestRunnerCounter[level="running"] { background-color: #E6F0FA; color: #2B5789; border-color: rgba(61, 119, 194,0.50); }
QLabel#TestRunnerCounter[level="pending"] { background-color: #FFFFFF; color: #9AA0B0; border-color: #E5E7EE; }

QPushButton#TestRunnerStopBtn,
QPushButton#TestRunnerClearBtn {
    background-color: #FFFFFF;
    color: #6A6A75;
    border: 1px solid #D5D9E4;
    border-radius: 4px;
    padding: 4px 14px;
    font-weight: 500;
}
QPushButton#TestRunnerStopBtn:hover  { background-color: #F9E5E6; color: #A33A3E; border-color: rgba(216, 75, 80,0.45); }
QPushButton#TestRunnerClearBtn:hover { background-color: #E9EBF2; border-color: #9AA0B0; color: #20232E; }

/* ---- History filters + date dividers (mockup panel 5) ----------- */
QComboBox#HistoryFilter {
    background-color: #FFFFFF;
    color: #20232E;
    border: 1px solid #D5D9E4;
    border-radius: 4px;
    padding: 3px 10px;
    font-size: 12px;
    min-height: 24px;
    min-width: 100px;
}
QComboBox#HistoryFilter:hover { border-color: #9AA0B0; }
QComboBox#HistoryFilter::drop-down { border: none; width: 18px; }
QToolButton#HistoryIconBtn {
    background-color: #FFFFFF;
    color: #6A6A75;
    border: 1px solid #D5D9E4;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 14px;
    min-height: 24px;
    min-width: 28px;
}
QToolButton#HistoryIconBtn:hover { background-color: #E9EBF2; border-color: #9AA0B0; }
QPushButton#HistoryClearBtn {
    background-color: #FFFFFF;
    color: #6A6A75;
    border: 1px solid #D5D9E4;
    border-radius: 4px;
    padding: 2px 12px;
    font-size: 12px;
    min-height: 24px;
}
QPushButton#HistoryClearBtn:hover { background-color: #F9E5E6; color: #A33A3E; border-color: rgba(216, 75, 80,0.45); }
QLabel#HistoryDivider {
    color: #9AA0B0;
    background-color: #FFFFFF;
    border-bottom: 1px solid #E5E7EE;
    padding: 6px 10px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.10em;
}

/* ---- Favorites count footer (mockup panel 4) -------------------- */
QLabel#FavoritesCount {
    color: #9AA0B0;
    background-color: #FFFFFF;
    border-top: 1px solid #E5E7EE;
    padding: 6px 14px;
    font-size: 11px;
    font-weight: 500;
}

/* ---- Settings dialog (sidebar nav, mockup panel 7) -------------- */
QDialog#SettingsDialog { background-color: #FFFFFF; }

QListWidget#SettingsNav {
    background-color: #FFFFFF;
    border: none;
    border-right: 1px solid #E5E7EE;
    outline: 0;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
    padding: 12px 0;
}
QListWidget#SettingsNav::item {
    color: #6A6A75;
    padding: 8px 18px;
    border: none;
    border-left: 3px solid transparent;
}
QListWidget#SettingsNav::item:hover {
    background-color: #E9EBF2;
    color: #20232E;
}
QListWidget#SettingsNav::item:selected {
    background-color: #EEF0FC;
    color: #4A5BC9;
    border-left: 3px solid #5B6EE0;
    font-weight: 600;
}

QStackedWidget#SettingsBody { background-color: #FFFFFF; }
QLabel#SettingsAccountUri {
    color: #9AA0B0;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 11px;
    padding-left: 4px;
}
QLabel#SettingsSectionLabel {
    color: #9AA0B0;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.10em;
    padding: 6px 0 2px 0;
}
QFrame#SettingsHr {
    background-color: #E5E7EE;
    border: none;
    max-height: 1px;
    min-height: 1px;
}
/* Registration status pill in the Account pane. */
QLabel#SettingsRegPill {
    background-color: #E5E7EE;
    color: #6A6A75;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 1px 10px;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 10px;
    font-weight: 700;
}
QLabel#SettingsRegPill[level="ok"]    { background-color: #E2F4EA; color: #2BA36B; border-color: rgba(43, 163, 107,0.4); }
QLabel#SettingsRegPill[level="warn"]  { background-color: #FBF1DD; color: #B07811; border-color: rgba(176, 120, 17,0.45); }
QLabel#SettingsRegPill[level="error"] { background-color: #F9E5E6; color: #A33A3E; border-color: rgba(216, 75, 80,0.45); }

QPushButton#SettingsTestRegBtn {
    background-color: #FFFFFF;
    color: #20232E;
    border: 1px solid #D5D9E4;
    border-radius: 4px;
    padding: 4px 14px;
    font-weight: 500;
}
QPushButton#SettingsTestRegBtn:hover { background-color: #E9EBF2; border-color: #9AA0B0; }

QFrame#SettingsFooter {
    background-color: #FFFFFF;
    border: none;
    border-top: 1px solid #E5E7EE;
}
QPushButton#SettingsResetBtn,
QPushButton#SettingsOkBtn,
QPushButton#SettingsCancelBtn {
    background-color: #FFFFFF;
    color: #6A6A75;
    border: 1px solid #D5D9E4;
    border-radius: 4px;
    padding: 0 16px;
    font-weight: 500;
}
QPushButton#SettingsResetBtn:hover,
QPushButton#SettingsOkBtn:hover,
QPushButton#SettingsCancelBtn:hover {
    background-color: #E9EBF2;
    border-color: #9AA0B0;
    color: #20232E;
}

/* ---- Recent Calls strip (mockup panel 1) ------------------------- */
QFrame#RecentsStrip {
    background-color: transparent;
    border: none;
    border-top: 1px solid #E5E7EE;
}
QLabel#RecentsHeader {
    color: #20232E;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
    font-weight: 600;
    padding: 6px 4px 2px 4px;
}
QToolButton#RecentsViewAll {
    background: transparent;
    color: #3D77C2;
    border: none;
    font-size: 11px;
    font-weight: 500;
    padding: 4px 6px;
}
QToolButton#RecentsViewAll:hover { color: #2B5789; text-decoration: underline; }
QLabel#RecentsEmpty {
    color: #9AA0B0;
    font-size: 11px;
    padding: 12px 8px;
}
QFrame#RecentsRow {
    /* `border: 0` reset BEFORE border-bottom is required for the
       :hover bg to paint full-width (Qt qstylesheetstyle border-box
       shrinking gotcha -- same fix as DenseListRow / HistoryRow).
       Padding moved off the layout's contentsMargins so the bg
       covers the full row including the visual padding area. */
    background-color: transparent;
    border: 0;
    border-bottom: 1px solid #E9EBF2;
    padding: 4px 6px 4px 8px;
    margin: 0;
}
QFrame#RecentsRow:hover { background-color: #E9EBF2; }
/* Force child labels transparent so the row hover bg shows through
   instead of painting a "white inside grey" inset around the text.
   Applied per-rule below on each child label individually. */
QLabel#RecentsArrow {
    background-color: transparent;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
    font-weight: 700;
}
QLabel#RecentsArrow[level="ok-out"]    { color: #2BA36B; }
QLabel#RecentsArrow[level="fail-out"]  { color: #D84B50; }
QLabel#RecentsArrow[level="ok-in"]     { color: #3D77C2; }
QLabel#RecentsArrow[level="miss-in"]   { color: #D84B50; }
QLabel#RecentsPeer {
    background-color: transparent;
    color: #20232E;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 11px;
    font-weight: 500;
}
/* SIP-status pill chip — colour-coded by level. */
QLabel#RecentsChip {
    background-color: #E5E7EE;
    color: #6A6A75;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 1px 8px;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.04em;
    min-width: 38px;
}
QLabel#RecentsChip[level="ok"] {
    background-color: #E2F4EA;
    color: #2BA36B;
    border-color: rgba(43, 163, 107,0.4);
}
QLabel#RecentsChip[level="progress"] {
    background-color: #FBF1DD;
    color: #B07811;
    border-color: rgba(176, 120, 17,0.45);
}
QLabel#RecentsChip[level="auth"] {
    background-color: #FBF1DD;
    color: #B07811;
    border-color: rgba(176, 120, 17,0.55);
}
QLabel#RecentsChip[level="warn"] {
    background-color: #EEF0FC;
    color: #4A5BC9;
    border-color: rgba(91, 110, 224,0.4);
}
QLabel#RecentsChip[level="error"] {
    background-color: #F9E5E6;
    color: #A33A3E;
    border-color: rgba(216, 75, 80,0.45);
}
QLabel#RecentsTime {
    background-color: transparent;
    color: #9AA0B0;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 10px;
    min-width: 56px;
}
QToolButton#RecentsCallBtn {
    background-color: #5B6EE0;
    color: #FFFFFF;
    border: 1px solid #5B6EE0;
    border-radius: 14px;
    font-size: 14px;
    font-weight: 700;
    min-width: 28px;
    min-height: 28px;
    max-width: 28px;
    max-height: 28px;
}
QToolButton#RecentsCallBtn:hover { background-color: #6C7EE8; border-color: #6C7EE8; }
QToolButton#RecentsCallBtn:pressed { background-color: #4A5BC9; }
QToolButton#RecentsCallBtn::menu-indicator { image: none; width: 0; }
QLabel#StatValue {
    background-color: transparent;
    color: #20232E;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 16px;
    font-weight: 600;
}

/* ------------------------------------------------------------------
   Operator redesign primitives
   ------------------------------------------------------------------ */
QWidget:focus {
    outline: none;
}
QLineEdit:focus, QTextEdit:focus, QComboBox:focus, QSpinBox:focus, QToolButton:focus, QPushButton:focus {
    border: 1px solid #5B6EE0;
}
QLabel#StatusPill, QLabel#SipCodeBadge, QLabel#MetricChip {
    border-radius: 4px;
    padding: 2px 8px;
    min-height: 18px;
    font-size: 11px;
    font-weight: 600;
}
QLabel#StatusPill[level="ok"], QLabel#SipCodeBadge[level="ok"], QLabel#MetricChip[level="ok"] {
    color: #1D7A4F;
    background-color: #E2F4EA;
    border: 1px solid #2BA36B;
}
QLabel#StatusPill[level="progress"], QLabel#SipCodeBadge[level="progress"], QLabel#MetricChip[level="progress"] {
    color: #8A5F0E;
    background-color: #FBF1DD;
    border: 1px solid #B07811;
}
QLabel#StatusPill[level="danger"], QLabel#SipCodeBadge[level="danger"], QLabel#MetricChip[level="danger"] {
    color: #A33A3E;
    background-color: #F9E5E6;
    border: 1px solid #D84B50;
}
QLabel#StatusPill[level="info"], QLabel#SipCodeBadge[level="info"], QLabel#MetricChip[level="info"] {
    color: #2B5789;
    background-color: #E6F0FA;
    border: 1px solid #3D77C2;
}
QLabel#StatusPill[level="muted"], QLabel#SipCodeBadge[level="muted"], QLabel#MetricChip[level="muted"] {
    color: #6A6A75;
    background-color: #E9EBF2;
    border: 1px solid #D5D9E4;
}
QToolButton#IconActionButton {
    background-color: transparent;
    border: 1px solid #D5D9E4;
    border-radius: 4px;
    padding: 0;
}
QToolButton#IconActionButton:hover {
    background-color: #E9EBF2;
}
QFrame#FormSection {
    background-color: transparent;
    border: none;
}
QLabel#SectionHeader {
    color: #6A6A75;
    font-size: 11px;
    font-weight: 700;
}
QFrame#FooterActionBar {
    background-color: #FFFFFF;
    border-top: 1px solid #D5D9E4;
}
QPushButton#PrimaryAction {
    min-height: 32px;
    border-radius: 4px;
    padding: 0 14px;
    background-color: #5B6EE0;
    border: 1px solid #5B6EE0;
    color: #FFFFFF;
    font-weight: 700;
}
QPushButton#SecondaryAction {
    min-height: 32px;
    border-radius: 4px;
    padding: 0 14px;
    background-color: #FFFFFF;
    border: 1px solid #D5D9E4;
    color: #20232E;
}
QFrame#TopStrip {
    background-color: #FFFFFF;
    border: none;
    border-bottom: 1px solid #D5D9E4;
}
QFrame#BottomTabs {
    background-color: #FFFFFF;
    border: none;
    border-top: 1px solid #D5D9E4;
}
QToolButton#TabBtn {
    background: transparent;
    color: #9AA0B0;
    border: none;
    border-top: 2px solid transparent;
    padding: 4px 0 3px 0;
    min-height: 36px;
    min-width: 56px;
    font-size: 10px;
}
QToolButton#TabBtn:checked {
    background-color: #FFFFFF;
    border-top-color: #5B6EE0;
    color: #5B6EE0;
}
QLineEdit#DialInput {
    background-color: #E5E7EE;
    color: #20232E;
    border: 1px solid #E5E7EE;
    border-radius: 4px;
    padding: 0 12px;
    font-size: 13px;
    min-height: 32px;
    max-height: 36px;
}
QPushButton#CallButton {
    background-color: #5B6EE0;
    color: #FFFFFF;
    border: 1px solid #5B6EE0;
    border-radius: 4px;
    padding: 0 18px;
    min-height: 32px;
    max-height: 36px;
    min-width: 60px;
    font-weight: 700;
    font-size: 14px;
}
QWidget#DialPad QPushButton#DialPadButton {
    min-height: 40px;
    max-height: 48px;
    border-radius: 4px;
    background: transparent;
    border: 1px solid transparent;
}
QWidget#DialPad QPushButton#DialPadButton:hover {
    background-color: #E9EBF2;
}
QFrame#QuickDialRow {
    border-bottom: 1px solid #D5D9E4;
}
QPushButton#HangupButton {
    background-color: #D84B50;
    color: #FFFFFF;
    border: 1px solid #D84B50;
    border-radius: 4px;
    padding: 7px 14px;
    min-height: 32px;
    min-width: 44px;
    font-weight: 600;
}
QPushButton#CallControlButton {
    min-height: 28px;
    border-radius: 4px;
    background-color: #FFFFFF;
    border: 1px solid #D5D9E4;
    color: #6A6A75;
}
QPushButton#CallControlButton:hover {
    background-color: #E9EBF2;
}
QFrame#DenseListRow {
    border: 0;
    border-bottom: 1px solid #D5D9E4;
    background-color: transparent;
    /* Visual inner padding lives here (NOT on the layout's contents
       margin) so the QSS hover background paints the full widget
       rect including this padding area. */
    padding: 7px 8px 7px 24px;
    margin: 0;
}
/* Full-row gray hover. Light mode -> #E9EBF2 (definitely gray, not
   the near-white #E9EBF2 that read as 'still white'). Focus +
   pressed echo the same shade so a clicked row stays consistent. */
QFrame#DenseListRow:hover,
QFrame#DenseListRow:focus,
QFrame#DenseListRow:pressed {
    background-color: #E9EBF2;
    outline: none;
}
QLabel#DenseRowMarker {
    background-color: transparent;
    font-size: 13px;
    color: #5B6EE0;
}
QLabel#DenseRowTitle {
    background-color: transparent;
    font-size: 13px;
    font-weight: 600;
}
QLabel#DenseRowSubtitle {
    background-color: transparent;
    font-size: 11px;
    color: #6A6A75;
}
QFrame#DenseRowActions {
    background-color: transparent;
    border: none;
}
/* Neutralised -- see earlier rule. Was a pale red wash that the
   operator found noisy across the whole row list. */
QFrame#HistoryRow[result="missed"], QFrame#HistoryRow[result="failed"] {
    background-color: transparent;
}
QLabel#TraceMsgDir[dir="rx"] {
    color: #3D77C2;
}
QLabel#TraceMsgDir[dir="tx"] {
    color: #1D7A4F;
}
QTextEdit#TraceMsgBody {
    background-color: #FFFFFF;
    color: #20232E;
    border: none;
    border-top: 1px solid #E5E7EE;
    padding: 6px 28px;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 11px;
}
QDialog QLineEdit, QDialog QComboBox, QDialog QSpinBox {
    min-height: 30px;
}
QLabel#DialogError {
    color: #D84B50;
    font-size: 12px;
}
QFrame#DialogRail {
    border-right: 1px solid #D5D9E4;
}
QFrame#OperatorToolbar {
    border: 1px solid #D5D9E4;
    border-radius: 4px;
    padding: 6px;
}
QPushButton#RunTestButton {
    min-height: 32px;
    border-radius: 4px;
    background-color: #5B6EE0;
    color: #FFFFFF;
    font-weight: 700;
}
QPushButton#RejectButton {
    min-height: 32px;
    border-radius: 4px;
    background-color: #D84B50;
    color: #FFFFFF;
}

/* ---------- Contacts row 3-dot kebab + filter button (panel 3) ---------- */
QToolButton#ContactRowMore {
    border: none;
    background: transparent;
    color: #6A6A75;
    font-size: 16px;
    font-weight: 700;
    padding: 0;
    border-radius: 4px;
}
QToolButton#ContactRowMore:hover {
    background-color: #E6F0FA;
    color: #20232E;
}
QToolButton#ContactRowMore::menu-indicator {
    image: none;
    width: 0;
}
QMenu#ContactRowMenu, QMenu#ContactsFilterMenu {
    background-color: #FFFFFF;
    border: 1px solid #D5D9E4;
    border-radius: 6px;
    padding: 4px;
}
QMenu#ContactRowMenu::item, QMenu#ContactsFilterMenu::item {
    padding: 6px 14px 6px 14px;
    border-radius: 4px;
    color: #20232E;
}
QMenu#ContactRowMenu::item:selected, QMenu#ContactsFilterMenu::item:selected {
    background-color: #E6F0FA;
}
QMenu#ContactRowMenu::separator, QMenu#ContactsFilterMenu::separator {
    height: 1px;
    background: #E9EBF2;
    margin: 4px 6px;
}
QToolButton#ContactsActionBtn[active="true"] {
    background-color: #E6F0FA;
    border: 1px solid #3D77C2;
    border-radius: 4px;
}

/* ---------- Audio TX/RX live meters in top strip (panel 1) ---------- */
QProgressBar#AudioMeterTX, QProgressBar#AudioMeterRX {
    background-color: #E9EBF2;
    border: 1px solid #D5D9E4;
    border-radius: 3px;
    text-align: center;
}
QProgressBar#AudioMeterTX::chunk {
    background-color: #2BA36B;
    border-radius: 2px;
}
QProgressBar#AudioMeterRX::chunk {
    background-color: #2B5789;
    border-radius: 2px;
}
QLabel#AudioMeterLabel {
    color: #6A6A75;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
    min-width: 18px;
}

/* ---------- Unified Call Stack (Dial page multi-call) ---------- */
QFrame#CallStrips {
    background-color: transparent;
}
/* Header bar: "N calls" left + End-all ghost link right. Only shown
   when there are 2+ active calls. */
QFrame#CallStackHeader {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid #E9EBF2;
}
QLabel#CallStackHeaderLabel {
    color: #6A6A75;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
}
QPushButton#CallStackEndAllLink {
    background: transparent;
    border: none;
    color: #D84B50;
    font-size: 11px;
    font-weight: 600;
    padding: 0 4px;
}
QPushButton#CallStackEndAllLink:hover {
    color: #A33A3E;
    text-decoration: underline;
}
/* Compact call card (36px) for OTHER calls. White surface, hairline,
   colored state-dot on the left. Selected (top, expanded) call
   lives in the main CallWidget. */
QFrame#CallStripRow {
    background-color: #FFFFFF;
    border: none;
    border-bottom: 1px solid #E9EBF2;
    margin: 0;
}
QFrame#CallStripRow:hover {
    background-color: #FFFFFF;
}
QLabel#CallStripDot {
    color: #D5D9E4;        /* idle */
    font-size: 14px;
    font-weight: 700;
}
QLabel#CallStripDot[state="confirmed"] { color: #2BA36B; }
QLabel#CallStripDot[state="held"]      { color: #B07811; }
QLabel#CallStripDot[state="incoming"]  { color: #D84B50; }
QLabel#CallStripDot[state="calling"]   { color: #5B6EE0; }
QLabel#CallStripDot[state="early"]     { color: #5B6EE0; }
QLabel#CallStripPeer {
    color: #20232E;
    font-size: 13px;
    font-weight: 500;
}
QLabel#CallStripDuration {
    color: #6A6A75;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 12px;
}
QToolButton#CallStripEndBtn {
    background-color: transparent;
    color: #D84B50;
    border: 1px solid transparent;
    border-radius: 11px;
    font-size: 12px;
    font-weight: 700;
}
QToolButton#CallStripEndBtn:hover {
    background-color: #F9E5E6;
    border-color: #D84B50;
    color: #A33A3E;
}

/* ---------- Audio strip mic-mute checked + chevron ---------- */
QToolButton#AudioBtn:checked {
    background-color: #F9E5E6;
    border: 1px solid #D84B50;
    border-radius: 3px;
}
QToolButton#AudioChevron {
    background: transparent;
    border: none;
    color: #6A6A75;
    font-size: 10px;
    padding: 0 2px;
    min-width: 12px;
    max-width: 14px;
}
QToolButton#AudioChevron:hover {
    color: #20232E;
}
QToolButton#AudioChevron::menu-indicator { image: none; width: 0; }

/* ---------- Compact CallWidget single-row card ---------- */
QToolButton#CallRowIconBtn {
    background-color: #FFFFFF;
    border: 1px solid #D5D9E4;
    border-radius: 4px;
    padding: 0;
}
QToolButton#CallRowIconBtn:hover {
    background-color: #E6F0FA;
    border: 1px solid #D5D9E4;
}
QToolButton#CallRowIconBtn:checked {
    background-color: #F9E5E6;
    border: 1px solid #D84B50;
}
QToolButton#CallRowIconBtn:disabled {
    background-color: #E9EBF2;
    border: 1px solid #E9EBF2;
}
QToolButton#CallRowEndBtn {
    background-color: #D84B50;
    border: 1px solid #A33A3E;
    border-radius: 4px;
    padding: 0 6px;
}
QToolButton#CallRowEndBtn:hover {
    background-color: #A33A3E;
}
QToolButton#CallRowEndBtn:disabled {
    background-color: #F9E5E6;
    border: 1px solid #D84B50;
}

/* ---------- Trace LIVE badge + pause toggle + delta column ---------- */
QLabel#TraceLiveBadge {
    color: #2BA36B;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.06em;
    padding: 0 6px;
}
QLabel#TraceLiveBadge[state="paused"] {
    color: #B07811;
}
QToolButton#TracePauseBtn {
    background-color: #FFFFFF;
    border: 1px solid #D5D9E4;
    border-radius: 4px;
    padding: 2px 8px;
    color: #20232E;
    font-size: 11px;
    min-height: 22px;
}
QToolButton#TracePauseBtn:hover {
    background-color: #E6F0FA;
    border-color: #D5D9E4;
}
QToolButton#TracePauseBtn:checked {
    background-color: #FBF1DD;
    border-color: #B07811;
    color: #8A5F0E;
}
QLabel#TraceMsgDelta {
    color: #9AA0B0;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 10px;
    letter-spacing: 0.04em;
}

/* ---------- Modernized Settings panes (card-based) ---------- */
QWidget#SettingsPane {
    background-color: #F2F3F7;
}
/* Free-standing labels inside a SettingsPane must NOT get their default
   widget background -- on Windows that defaults to white, producing a
   visible white block behind every title/blurb against the F6F7F9 pane.
   Qt's QLabel inherits the parent palette but only with an explicit
   transparent background. */
QWidget#SettingsPane > QLabel,
QWidget#SettingsPane QLabel#SettingsTitle,
QWidget#SettingsPane QLabel#SettingsSubtitle,
QWidget#SettingsPane QLabel#SettingsBlurb,
QWidget#SettingsPane QLabel#SettingsRowLabel,
QWidget#SettingsPane QLabel#SettingsRowHint {
    background-color: transparent;
}
QLabel#SettingsTitle {
    color: #20232E;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.005em;
    padding-bottom: 2px;
    background-color: transparent;
}
QLabel#SettingsSubtitle {
    color: #6A6A75;
    font-size: 12px;
    line-height: 1.4em;
    padding-bottom: 4px;
    background-color: transparent;
}
QLabel#SettingsBlurb {
    color: #6A6A75;
    font-size: 12px;
    line-height: 1.4em;
    padding-bottom: 8px;
    background-color: transparent;
}
QFrame#SettingsCard {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EE;
    border-radius: 6px;
}
QFrame#SettingsCard QLabel#SettingsCardLabel {
    color: #6A6A75;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    padding-bottom: 8px;
    border-bottom: 1px solid #E9EBF2;
    margin-bottom: 4px;
}
QLabel#SettingsRowLabel {
    color: #6A6A75;
    font-size: 13px;
    font-weight: 500;
}
QLabel#SettingsRowValue {
    color: #20232E;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 12px;
}
QLabel#SettingsRowHint {
    color: #9AA0B0;
    font-size: 11px;
    padding-top: 2px;
}
QCheckBox#SettingsCheckbox {
    color: #20232E;
    font-size: 13px;
    padding: 2px 0;
    spacing: 8px;
}
QPushButton#SettingsLinkBtn {
    background: transparent;
    border: none;
    color: #5B6EE0;
    font-size: 12px;
    font-weight: 500;
    padding: 2px 6px;
    text-align: left;
}
QPushButton#SettingsLinkBtn:hover {
    color: #4A5BC9;
    text-decoration: underline;
}

/* ---------- Modernized Test Runner ---------- */
QWidget#TestRunnerRoot {
    background-color: #F2F3F7;
}
QSplitter#TestRunnerSplit::handle {
    background-color: transparent;
}
QSplitter#TestRunnerSplit::handle:hover {
    background-color: #E5E7EE;
}
QWidget#TestRunnerLeft {
    background-color: transparent;
}
/* Reuse SettingsCard inside TestRunner. The results card gets a
   tighter inner padding so the table can breathe. */
QTextEdit#TestRunnerPasteBox {
    background-color: #FFFFFF;
    border: 1px solid #D5D9E4;
    border-radius: 6px;
    padding: 8px 10px;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 12px;
    selection-background-color: #E6F0FA;
    color: #20232E;
    min-height: 90px;
}
QTextEdit#TestRunnerPasteBox:focus {
    border-color: #5B6EE0;
    background-color: #FFFFFF;
}
QLabel#TestRunnerCountBadge {
    background-color: #EEF0FC;
    color: #4A5BC9;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 600;
}
/* Results table inside its card */
QTableWidget#TestRunnerResults {
    background-color: #FFFFFF;
    border: none;
    gridline-color: transparent;
    alternate-background-color: #FFFFFF;
    /* Selection: muted cyan instead of the peach orange that read as
     * a second "fail" colour next to the FAIL badges. Selection-colour
     * stays dark for readability. */
    selection-background-color: #EEF0FC;
    selection-color: #20232E;
}
QTableWidget#TestRunnerResults::item {
    padding: 8px 12px;
    border-bottom: 1px solid #E9EBF2;
    background-color: transparent;
}
QTableWidget#TestRunnerResults::item:hover {
    background-color: #F2F3F7;
}
/* Explicit selected-cell rule so the per-cell rendering picks up the
   table's selection colour even when the cell hosts a setCellWidget()
   badge or empty placeholder ("-"). Without this, empty cells were
   painting their default Qt-palette white inside the selected row. */
QTableWidget#TestRunnerResults::item:selected {
    background-color: #EEF0FC;
    color: #20232E;
}
QTableWidget#TestRunnerResults QHeaderView::section {
    background-color: #FFFFFF;
    color: #6A6A75;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    padding: 10px 12px;
    border: none;
    border-bottom: 1px solid #E5E7EE;
}
QFrame#TestRunnerFooter {
    background: transparent;
}

/* ---------- Modern codec list (Settings → Codecs pane) ---------- */
QFrame#CodecListHeader {
    background-color: #FFFFFF;
    border: none;
    border-bottom: 1px solid #E9EBF2;
}
QLabel#CodecListHeaderLabel {
    color: #6A6A75;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
}
QFrame#CodecRow {
    background-color: #FFFFFF;
    border: none;
    border-bottom: 1px solid #E9EBF2;
}
QFrame#CodecRow:hover {
    background-color: #FFFFFF;
}
QLabel#CodecRowName {
    background: transparent;
    border: none;
    color: #20232E;
    font-size: 13px;
    font-weight: 600;
}
QLabel#CodecRowSub {
    background: transparent;
    border: none;
    color: #9AA0B0;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 11px;
}
QSpinBox#CodecRowPriority {
    background-color: #FFFFFF;
    border: 1px solid #D5D9E4;
    border-radius: 6px;
    padding: 4px 10px;
    color: #20232E;
    font-size: 13px;
    font-weight: 600;
    min-height: 26px;
}
QSpinBox#CodecRowPriority:focus {
    border-color: #5B6EE0;
}
QToolButton#CodecRowReorderBtn {
    background-color: #FFFFFF;
    border: 1px solid #D5D9E4;
    border-radius: 6px;
    color: #6A6A75;
    font-size: 11px;
    font-weight: 700;
    padding: 0;
}
QToolButton#CodecRowReorderBtn:hover {
    background-color: #E6F0FA;
    border-color: #D5D9E4;
    color: #20232E;
}
QToolButton#CodecRowReorderBtn:pressed {
    background-color: #E5E7EE;
}

/* =====================================================================
   Redesigned Test Runner toolbar + preflight + tabs
   ===================================================================== */
QFrame#TestRunnerToolbar {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EE;
    border-radius: 8px;
}
QLabel#TestRunnerToolbarLabel {
    color: #6A6A75;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    background: transparent;
}
QLabel#TestRunnerToolbarSep {
    color: #D5D9E4;
    font-size: 13px;
    padding: 0 2px;
    background: transparent;
}
QFrame#TestRunnerPreflight {
    background-color: #EEF0FC;
    border: 1px solid #EEF0FC;
    border-radius: 6px;
}
QLabel#TestRunnerPreflightLabel {
    color: #20232E;
    font-size: 12px;
    background: transparent;
}
/* Section header above each paste box (Targets / Callers). Acts as
   both label and live counter (text updated by _refresh_plan_preview).
   Styled like a settings card label so the two panes read as parallel
   stacked sections rather than as a tab. */
QLabel#TestRunnerPasteHeader {
    color: #6A6A75;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    padding: 2px 0;
    background: transparent;
}
QToolButton#TestRunnerTab {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 6px 12px;
    color: #6A6A75;
    font-size: 12px;
    font-weight: 600;
}
QToolButton#TestRunnerTab:hover { color: #20232E; }
QToolButton#TestRunnerTab:checked {
    color: #5B6EE0;
    border-bottom-color: #5B6EE0;
}


/* Account dialog Advanced disclosure */
QToolButton#AccountAdvancedToggle {
    background: transparent;
    border: none;
    color: #6A6A75;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    padding: 2px 4px;
}
QToolButton#AccountAdvancedToggle:hover { color: #20232E; }
QLabel#AccountAdvancedSummary {
    color: #9AA0B0;
    font-size: 11px;
    font-family: "Cascadia Mono", "Consolas", monospace;
    background: transparent;
}
QFrame#AccountAdvancedBody {
    background-color: transparent;
    border: none;
}
QPushButton#AccountTestGhostBtn {
    background: transparent;
    border: 1px solid #E5E7EE;
    color: #6A6A75;
    padding: 6px 12px;
    border-radius: 6px;
}
QPushButton#AccountTestGhostBtn:hover {
    background-color: #E9EBF2;
    border-color: #D5D9E4;
    color: #20232E;
}

/* =====================================================================
   Modern flat styling for input widgets (combos, spinboxes, line edits)
   Replaces the native Windows look with a consistent flat aesthetic.
   Named overrides earlier in the file still win by selector specificity.
   ===================================================================== */
QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #D5D9E4;
    border-radius: 6px;
    padding: 5px 30px 5px 10px;
    font-size: 13px;
    color: #20232E;
    min-height: 20px;
    selection-background-color: #EEF0FC;
    selection-color: #20232E;
}
QComboBox:hover { border-color: #9AA0B0; }
QComboBox:focus, QComboBox:on { border-color: #6C7EE8; }
QComboBox:disabled {
    background-color: #F2F3F7;
    color: #9AA0B0;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 26px;
    border: none;
    background: transparent;
}
QComboBox::down-arrow {
    image: url(__ARROW_DOWN__);
    width: 12px;
    height: 12px;
}
QComboBox::down-arrow:disabled {
    image: url(__ARROW_DOWN_LIGHT__);
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #D5D9E4;
    border-radius: 6px;
    selection-background-color: #EEF0FC;
    selection-color: #20232E;
    padding: 4px 0;
    outline: 0;
}
QComboBox QAbstractItemView::item {
    padding: 6px 12px;
    min-height: 22px;
    border: none;
    color: #20232E;
}
QComboBox QAbstractItemView::item:hover {
    background-color: #F2F3F7;
}
QComboBox QAbstractItemView::item:selected {
    background-color: #EEF0FC;
    color: #20232E;
}

/* ------ Spinboxes ----- */
QSpinBox, QDoubleSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #D5D9E4;
    border-radius: 6px;
    padding: 5px 28px 5px 10px;
    font-size: 13px;
    color: #20232E;
    min-height: 20px;
}
QSpinBox:hover, QDoubleSpinBox:hover { border-color: #9AA0B0; }
QSpinBox:focus, QDoubleSpinBox:focus { border-color: #6C7EE8; }
QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: #F2F3F7;
    color: #9AA0B0;
}
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 22px;
    height: 14px;
    border: none;
    border-top-right-radius: 6px;
    background: transparent;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 22px;
    height: 14px;
    border: none;
    border-bottom-right-radius: 6px;
    background: transparent;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #F2F3F7;
}
QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed,
QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed {
    background-color: #E9EBF2;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(__ARROW_UP__);
    width: 10px;
    height: 10px;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(__ARROW_DOWN__);
    width: 10px;
    height: 10px;
}
QSpinBox::up-arrow:disabled, QDoubleSpinBox::up-arrow:disabled {
    image: url(__ARROW_UP_LIGHT__);
}
QSpinBox::down-arrow:disabled, QDoubleSpinBox::down-arrow:disabled {
    image: url(__ARROW_DOWN_LIGHT__);
}

/* ------ QLineEdit baseline (any QLineEdit without a named selector) -- */
QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #D5D9E4;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 13px;
    color: #20232E;
    selection-background-color: #EEF0FC;
    selection-color: #20232E;
}
QLineEdit:hover { border-color: #9AA0B0; }
QLineEdit:focus { border-color: #6C7EE8; }
QLineEdit:disabled {
    background-color: #F2F3F7;
    color: #9AA0B0;
}

/* ------ QCheckBox -- transparent so it doesn't paint a white block
   over the panel/group background. Modern flat indicator. -------- */
QCheckBox {
    background-color: transparent;
    color: #20232E;
    font-size: 13px;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1.5px solid #D5D9E4;
    border-radius: 4px;
    background-color: #FFFFFF;
}
QCheckBox::indicator:hover {
    border-color: #6C7EE8;
}
QCheckBox::indicator:checked {
    background-color: #6C7EE8;
    border-color: #6C7EE8;
}
QCheckBox::indicator:disabled {
    border-color: #E5E7EE;
    background-color: #F2F3F7;
}

/* Any QLabel nested inside a SettingsPane should be transparent.
   Without this, labels inside QGroupBox / QFormLayout get the Windows
   default white widget background. */
QWidget#SettingsPane QLabel,
QGroupBox QLabel,
QGroupBox QCheckBox {
    background-color: transparent;
}

/* ------ QGroupBox (used by FAS pane sections) -- flat section look -- */
/* No card background -- the section is delineated only by a subtle
   border + uppercase title. Removing the white fill stops the panes
   from looking like patches of stuck-on rectangles. */
QGroupBox {
    background-color: transparent;
    border: 1px solid #E5E7EE;
    border-radius: 8px;
    margin-top: 14px;
    padding: 14px 12px 10px;
    color: #20232E;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    left: 8px;
    color: #6A6A75;
    background-color: #F2F3F7;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
}

/* ------ Codec drag-drop columns ------------------------------------- */
QFrame#CodecDnDColumn {
    background-color: transparent;
}
QLabel#CodecDnDColumnLabel {
    color: #6A6A75;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 0 4px 2px;
    background-color: transparent;
}
QListWidget#CodecDnDList {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EE;
    border-radius: 8px;
    padding: 4px;
    color: #20232E;
    font-size: 13px;
    outline: 0;
}
QListWidget#CodecDnDList::item {
    padding: 8px 10px;
    border-radius: 6px;
    margin: 2px 0;
    color: #20232E;
}
QListWidget#CodecDnDList::item:hover {
    background-color: #F2F3F7;
}
QListWidget#CodecDnDList::item:selected {
    background-color: #EEF0FC;
    color: #20232E;
}

/* ------------------------------------------------------------------
   Row-child transparency override
   ------------------------------------------------------------------
   QFrame#HistoryRow / DenseListRow / ContactGroupRow paint their
   own QSS background on hover. Some of their CHILD widgets (labels,
   the arrow, the marker) inherit an opaque background via Qt's
   palette propagation -- that paints a WHITE inset over the row's
   gray hover, making it look like the gray has a hole punched in
   the middle. Force every child widget to transparent so the row's
   hover bg shows through everywhere.
   ------------------------------------------------------------------ */


/* ===== SECTION: SHELL ===== */

/* ===== SECTION: CALLS ===== */

/* ------------------------------------------------------------------
   In-call HERO card (call_widget.py). When a call exists this is the
   dominant element on the Dial page: a rounded card with a big mono
   number, a "via <account> · <supplier>" line, a status chip + a
   distinct ring/talk timer, labeled controls, and a red filled hang-up.
   Appended after the base CallCard block so these win by later-declaration.
   ------------------------------------------------------------------ */
QFrame#CallCard {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EE;
    border-radius: 8px;
}
/* An incoming call wants attention -> warn-tinted border (not a red wash). */
QFrame#CallCard[state="incoming"] {
    background-color: #FFFFFF;
    border: 1px solid #B07811;
}
QFrame#CallCard[state="active"] {
    border: 1px solid #E5E7EE;
}

/* Avatar is 32px in the hero -> 16px radius. State bg tints inherited. */
QLabel#CallAvatar {
    border-radius: 16px;
    font-size: 15px;
}

/* Big mono headline number (rule 3: phone numbers -> mono). */
QLabel#CallPeer {
    color: #20232E;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: 0.01em;
}
/* "via <account> · <supplier>" context line (sans -- it's labels). */
QLabel#CallContext {
    color: #6A6A75;
    font-size: 12px;
    font-weight: 500;
}
QLabel#CallPeerSub {
    color: #9AA0B0;
    font-size: 11px;
    font-weight: 400;
}

/* Status chip: pill (rule 4). Colour levels come from the base
   CallStatePill[level="..."] rules; enlarge slightly for the hero. */
QLabel#CallStatePill {
    border-radius: 10px;
    padding: 3px 12px;
    font-size: 11px;
}

/* Ring-time vs talk-time made distinct: caption tag + timer colour.
   RING = amber (warn), TALK = green (ok). */
QLabel#CallTimerCaption {
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #9AA0B0;
}
QLabel#CallTimerCaption[phase="ring"] { color: #B07811; }
QLabel#CallTimerCaption[phase="talk"] { color: #2BA36B; }
QLabel#CallTimerCaption[phase="hold"] { color: #B07811; }
QLabel#CallDuration {
    color: #20232E;
    font-family: "Cascadia Mono", "Cascadia Code", "Consolas", monospace;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.01em;
}
QLabel#CallDuration[phase="ring"] { color: #B07811; }
QLabel#CallDuration[phase="talk"] { color: #2BA36B; }
QLabel#CallDuration[phase="hold"] { color: #B07811; }

/* Labeled controls (Mute / Hold / Transfer): icon + text under, quiet
   ghost by default, danger tint when Mute is engaged (checked). */
QToolButton#CallCtrlBtn {
    background-color: #FFFFFF;
    color: #6A6A75;
    border: 1px solid #D5D9E4;
    border-radius: 8px;
    padding: 6px 8px;
    font-size: 11px;
    font-weight: 600;
}
QToolButton#CallCtrlBtn:hover {
    background-color: #E9EBF2;
    border-color: #9AA0B0;
    color: #20232E;
}
QToolButton#CallCtrlBtn:pressed { background-color: #E5E7EE; }
QToolButton#CallCtrlBtn:checked {
    background-color: #F9E5E6;
    border-color: #D84B50;
    color: #A33A3E;
}
QToolButton#CallCtrlBtn:disabled {
    background-color: #FFFFFF;
    border-color: #E5E7EE;
    color: #D5D9E4;
}

/* Red filled hang-up -- the dominant end action. */
QPushButton#CallHangupBtn {
    background-color: #D84B50;
    color: #FFFFFF;
    border: 1px solid #D84B50;
    border-radius: 8px;
    padding: 0 18px;
    font-size: 14px;
    font-weight: 700;
}
QPushButton#CallHangupBtn:hover { background-color: #A33A3E; border-color: #A33A3E; }
QPushButton#CallHangupBtn:pressed { background-color: #A33A3E; border-color: #A33A3E; }
QPushButton#CallHangupBtn:disabled {
    background-color: #E9EBF2; color: #D5D9E4; border-color: #E5E7EE;
}

/* Incoming: Answer = indigo primary; Reject = red filled (decline,
   mirrors the sanctioned red hang-up). */
QPushButton#CallAnswerBtn {
    background-color: #5B6EE0;
    color: #FFFFFF;
    border: 1px solid #5B6EE0;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 700;
}
QPushButton#CallAnswerBtn:hover { background-color: #6C7EE8; border-color: #6C7EE8; }
QPushButton#CallAnswerBtn:pressed { background-color: #4A5BC9; border-color: #4A5BC9; }
QPushButton#CallRejectBtn {
    background-color: #D84B50;
    color: #FFFFFF;
    border: 1px solid #D84B50;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 700;
}
QPushButton#CallRejectBtn:hover { background-color: #A33A3E; border-color: #A33A3E; }
QPushButton#CallRejectBtn:pressed { background-color: #A33A3E; border-color: #A33A3E; }

/* ------------------------------------------------------------------
   Calm list rows (history_view.py). The whole row redials; the per-row
   phone control is now a quiet GHOST icon shown only on hover as the
   click target (was a filled circle repeated down every row).
   ------------------------------------------------------------------ */
QToolButton#HistoryRowCall {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 4px;
    min-width: 26px;
    min-height: 26px;
}
QToolButton#HistoryRowCall:hover {
    background-color: #EEF0FC;
    border-color: #5B6EE0;
}
QToolButton#HistoryRowCall:disabled {
    background-color: transparent;
    border-color: transparent;
}

/* Bulk-select toggle: accent tint when active. */
QToolButton#HistoryIconBtn:checked {
    background-color: #EEF0FC;
    border-color: #5B6EE0;
    color: #4A5BC9;
}

/* Per-row selection checkbox -- only shown in bulk-select mode. */
QCheckBox#HistoryRowSelect {
    background-color: transparent;
    spacing: 0;
}

/* ------------------------------------------------------------------
   CDR detail dialog (cdr_detail_dialog.py) -- textual (non-mono) field
   values, e.g. the Account NAME (rule 3: only numbers/URIs/codes/times
   are mono).
   ------------------------------------------------------------------ */
QLabel#CdrDetailValueText {
    color: #20232E;
    font-size: 12px;
}

/* ------------------------------------------------------------------
   Active-calls list (call_list_widget.py).
   ------------------------------------------------------------------ */
QListWidget#CallList {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EE;
    border-radius: 8px;
    padding: 2px;
}
QListWidget#CallList::item {
    padding: 6px 8px;
    border-radius: 6px;
}
QListWidget#CallList::item:selected {
    background-color: #EEF0FC;
    color: #20232E;
}


/* ===== SECTION: AUX-WINDOWS ===== */

/* ------------------------------------------------------------------
   agent-aux: consistency layer for the four auxiliary windows
   (Settings / Accounts / SIP trace / Test runner). Roles only —
   colours come from the light palette + LIGHT_TO_DARK mapping.
   ------------------------------------------------------------------ */

/* Test Runner: Export CSV is a QUIET action (the one primary is Run). */
QPushButton#TestRunnerExportBtn {
    background-color: #FFFFFF;
    color: #6A6A75;
    border: 1px solid #D5D9E4;
    border-radius: 4px;
    padding: 4px 14px;
    min-height: 26px;
}
QPushButton#TestRunnerExportBtn:hover {
    background-color: #E9EBF2;
    border-color: #9AA0B0;
    color: #20232E;
}
QPushButton#TestRunnerExportBtn:pressed { background-color: #E5E7EE; }
QPushButton#TestRunnerExportBtn:disabled {
    color: #9AA0B0;
    background-color: #E9EBF2;
    border-color: #E5E7EE;
}

/* Test Runner summary chips: zero-count chips render muted so only the
   counts that matter carry their status colour. This rule sits after the
   per-level rules (end of file), so for a chip carrying both level=* and
   zero="true" the muted values win. */
QLabel#TestRunnerCounter[zero="true"] {
    background-color: #EEEFF3;
    color: #5F646E;
    border-color: #E5E7EE;
}

/* Account dialog: Test-registration status text uses palette status
   foregrounds (theme-derived) instead of a hardcoded inline hex. */
QLabel#AccountTestStatus {
    background: transparent;
    font-size: 12px;
    font-weight: 600;
}
QLabel#AccountTestStatus[level="ok"]       { color: #2BA36B; }
QLabel#AccountTestStatus[level="danger"]   { color: #D84B50; }
QLabel#AccountTestStatus[level="progress"] { color: #B07811; }

/* Empty-state icons + hints (design system rule 8). */
QLabel#TraceEmptyIcon, QLabel#ViewEmptyIcon {
    background: transparent;
    border: none;
}
QLabel#FasResultsEmpty {
    color: #9AA0B0;
    font-size: 12px;
    padding: 10px 24px;
}
